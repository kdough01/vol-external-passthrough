#!/bin/bash
#PBS -N g2_device_resident
#PBS -l select=1:ncpus=16:ngpus=1:mpiprocs=1:mem=128gb
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -A SDR
#PBS -q gpu

DATASETS="miranda scale-T s3d nyx_baryon ocean_temp qmc"
RATES="zfp_gpu_r4 zfp_gpu_r8 zfp_gpu_r12 zfp_gpu_r16"

# Control first, deliberately. See above.
ARMS="${ARMS:-none host device}"

PER_RATE="${PER_RATE:-0}"          # 1 => one process per (arm, dataset, rate)
RUN_SANITIZER="${RUN_SANITIZER:-1}" # re-run failed pairs under compute-sanitizer
PAIR_TIMEOUT="${PAIR_TIMEOUT:-1800}"

# Must match the geometry the rest of the figure was generated with, or the
# device bar is not comparable to the bars beside it.
CHUNKING="${VOL_COMP_CHUNKING:-none}"

cd "$PBS_O_WORKDIR/.." || exit 1
WORK="$(pwd)"
BUILD="build_g2"

STAMP="$(date +%Y%m%d_%H%M%S)_${PBS_JOBID%%.*}"
RES="$WORK/devres_results/$STAMP"
mkdir -p "$RES/logs" || { echo "ERROR: cannot create $RES"; exit 1; }

echo "Job started on $(date)   host=$(hostname)"
echo "arms=$ARMS  per_rate=$PER_RATE  chunking=$CHUNKING"
echo "results -> $RES"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

module load gcc/11.4.0
module load hpcx/2.26-gcc
module load cuda/12.6.0

LP_VIEW=/home/kdougherty/libpressio_cuda/.spack-env/view
CLEAN_PATH=$(echo "$PATH" | tr ':' '\n' | grep -v spack-env | tr '\n' ':')
GCC_LIB=$(gcc --print-file-name=libstdc++.so | xargs dirname 2>/dev/null)
[ "$GCC_LIB" = "." ] && GCC_LIB=/usr/lib/gcc/x86_64-linux-gnu/11

SYSTEM_MPICC=$(which mpicc)
SYSTEM_MPICXX=$(which mpicxx)
[ -x "$SYSTEM_MPICC" ] || { echo "ERROR: mpicc not on PATH -- module load hpcx?"; exit 1; }

LP_CMAKE_DIR=""
for candidate in \
    "${LP_VIEW}/lib64/cmake/LibPressio" "${LP_VIEW}/lib/cmake/LibPressio" \
    "${LP_VIEW}/lib64/cmake/libpressio" "${LP_VIEW}/lib/cmake/libpressio"; do
    if [ -f "${candidate}/LibPressioConfig.cmake" ] || \
       [ -f "${candidate}/libpressio-config.cmake" ]; then
        LP_CMAKE_DIR="$candidate"; break
    fi
done
[ -z "$LP_CMAKE_DIR" ] && { echo "ERROR: no LibPressioConfig.cmake under $LP_VIEW"; exit 1; }

echo ""
echo "=== building ($BUILD) ==="

if [ -f "$BUILD/CMakeCache.txt" ]; then
    CACHED_CC=$(sed -n 's/^CMAKE_C_COMPILER:[^=]*=//p' "$BUILD/CMakeCache.txt")
    if [ "$CACHED_CC" != "$SYSTEM_MPICC" ]; then
        echo "  cache holds CC='$CACHED_CC', need '$SYSTEM_MPICC' -- clearing $BUILD"
        rm -rf "$BUILD"
    fi
fi

env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" \
cmake -S . -B "$BUILD" \
    -DCMAKE_C_COMPILER="$SYSTEM_MPICC" -DCMAKE_CXX_COMPILER="$SYSTEM_MPICXX" \
    -DUSE_CUDA=ON -DCMAKE_PREFIX_PATH="$LP_VIEW" \
    -DLibPressio_DIR="$LP_CMAKE_DIR" \
    -DBUILD_EXAMPLES=OFF -Wno-dev \
    > "$RES/build.log" 2>&1 || { echo "cmake failed"; tail -30 "$RES/build.log"; exit 1; }
env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" cmake --build "$BUILD" -j16 \
    >> "$RES/build.log" 2>&1 \
    || { echo "build failed -- refusing to run a stale binary";
         tail -40 "$RES/build.log"; exit 1; }

BIN="$BUILD/bin/bench_vol_timing"
VOL_PLUGIN_PATH="${VOL_PLUGIN_PATH:-$WORK/$BUILD/lib}"
VOL_CONNECTOR="${VOL_CONNECTOR:-pass_through_ext under_vol=0;under_info={}}"
[ -x "$BIN" ] || { echo "ERROR: $BIN not found after build"; exit 1; }

H5DIR="${VOL_H5DIR:-/lcrc/project/SDR/$USER/vol_bench_h5}"
mkdir -p "$H5DIR" || { echo "ERROR: cannot create $H5DIR"; exit 1; }

MISSING=""
for sym in BENCH_DEVICE_INPUT BENCH_HOST_STAGED BENCH_STAGING_CSV; do
    strings "$BIN" 2>/dev/null | grep -q "$sym" || MISSING="$MISSING $sym"
done
if [ -n "$MISSING" ]; then
    echo ""
    echo ">>> ERROR: $BIN is missing:$MISSING -- apply the staging block first."
    exit 1
fi

MANIFEST="$RES/manifest.csv"
echo "arm,dataset,rate,exit,signal,note" > "$MANIFEST"
FAILED="$RES/failed_pairs.txt"
: > "$FAILED"

decode_exit () {
    case "$1" in
        0)   echo "ok"            ;;
        3)   echo "CUDA_FAULT"    ;;   # harness caught it and named the pair
        134) echo "SIGABRT"       ;;
        137) echo "SIGKILL/timeout" ;;
        139) echo "SIGSEGV"       ;;
        *)   echo "exit_$1"       ;;
    esac
}

# ------------------------------------------------------------- one process --
# arm=none is the control: no env var, so the harness never touches CUDA and
# wbuf is hbuf exactly as in the historical runs.
run_one () {
    local arm="$1" ds="$2" rates="$3" slug="$4"
    local dev=""
    case "$arm" in
        device) dev="BENCH_DEVICE_INPUT=1" ;;
        host)   dev="BENCH_HOST_STAGED=1"  ;;
        none)   dev=""                     ;;
        *)      echo "run_one: bad arm '$arm'"; return 1 ;;
    esac

    local log="$RES/logs/${arm}_${slug}.log"
    local rc

    env HDF5_PLUGIN_PATH="$VOL_PLUGIN_PATH" \
        HDF5_VOL_CONNECTOR="$VOL_CONNECTOR" \
        BENCH_ONLY="$ds" BENCH_COMP="$rates" \
        VOL_COMP_CHUNKING="$CHUNKING" \
        BENCH_STAGING_CSV="$RES/staging_${arm}_${slug}.csv" \
        $dev \
        timeout --signal=KILL "$PAIR_TIMEOUT" \
        "$BIN" "$H5DIR/g2_${arm}_${slug}.h5" \
               "$RES/results_vol_${arm}_${slug}.csv" \
               "$RES/results_vol_ext_${arm}_${slug}.csv" \
        > "$log" 2>&1
    rc=$?

    local what; what=$(decode_exit "$rc")
    printf '  %-7s %-12s %-24s %s\n' "$arm" "$ds" "$rates" "$what"

    # grep -c prints "0" and exits 1 on no match -- never chain `|| echo 0`.
    local nfail; nfail=$(grep -c '^\[FAIL\]' "$log"); nfail=${nfail:-0}
    local note=""
    [ "$nfail" -gt 0 ] && note="${nfail}_fidelity_FAIL"

    printf '%s,%s,%s,%d,%s,%s\n' "$arm" "$ds" "$rates" "$rc" "$what" "$note" \
        >> "$MANIFEST"

    if [ "$rc" != 0 ]; then
        echo "$arm $ds $rates" >> "$FAILED"
        echo "    last 12 lines of $log:"
        tail -12 "$log" | sed 's/^/      /'
        # The harness prints the exact pair on a caught CUDA fault.
        grep -m2 '^\[FATAL\]' "$log" | sed 's/^/    /'
    fi
    if [ "$nfail" -gt 0 ]; then
        echo "    $nfail [FAIL] fidelity line(s) -- timings not usable:"
        grep -m3 '^\[FAIL\]' "$log" | sed 's/^/      /'
    fi
}

echo ""
echo "############ measurement passes ############"
for arm in $ARMS; do
    echo ""
    echo "--- arm=$arm ---"
    for ds in $DATASETS; do
        if [ "$PER_RATE" = "1" ]; then
            for r in $RATES; do
                run_one "$arm" "$ds" "$r" "${ds}_${r}"
            done
        else
            run_one "$arm" "$ds" "$RATES" "$ds"
        fi
    done

    # The control arm is decisive: stop and say so rather than burning two more
    # passes on a configuration that is already known to be broken.
    if [ "$arm" = "none" ] && [ -s "$FAILED" ]; then
        echo ""
        echo ">>> The CONTROL arm failed. That arm sets no env var and hands"
        echo ">>> H5Dwrite the loader's own host buffer -- it is the historical"
        echo ">>> configuration. The device-resident change is not implicated."
        echo ">>> Fix the connector before interpreting anything else."
        echo ">>> Continuing anyway so the other arms are on the record."
    fi
done

# ------------------------------------------------------------- sanitizer ----
if [ "$RUN_SANITIZER" = "1" ] && [ -s "$FAILED" ]; then
echo ""
echo "############ compute-sanitizer on failed pairs ############"
if ! command -v compute-sanitizer >/dev/null 2>&1; then
    echo "  compute-sanitizer not on PATH (module load cuda provides it) -- skipped"
else
    # One rate at a time under the sanitizer: it is 10-100x slower, so the full
    # rate set per dataset will not finish. CUDA_LAUNCH_BLOCKING makes the
    # report point at the launching call rather than wherever the async error
    # happened to surface.
    while read -r arm ds rates; do
        r=$(echo "$rates" | awk '{print $1}')
        dev=""
        [ "$arm" = "device" ] && dev="BENCH_DEVICE_INPUT=1"
        [ "$arm" = "host"   ] && dev="BENCH_HOST_STAGED=1"
        out="$RES/logs/sanitizer_${arm}_${ds}_${r}.log"
        echo ""
        echo "--- compute-sanitizer $arm / $ds / $r ---"
        env HDF5_PLUGIN_PATH="$VOL_PLUGIN_PATH" \
            HDF5_VOL_CONNECTOR="$VOL_CONNECTOR" \
            BENCH_ONLY="$ds" BENCH_COMP="$r" \
            VOL_COMP_CHUNKING="$CHUNKING" \
            CUDA_LAUNCH_BLOCKING=1 \
            $dev \
        timeout --signal=KILL 3600 \
        compute-sanitizer --tool memcheck --leak-check no --print-limit 20 \
            "$BIN" "$H5DIR/g2_san.h5" "$RES/logs/san_${arm}_${ds}.csv" \
                   "$RES/logs/san_ext_${arm}_${ds}.csv" \
            > "$out" 2>&1
        echo "  wrote $out"
        grep -m20 -E '========= (Invalid|Program hit|Address)' "$out" \
            | sed 's/^/    /' || echo "    (no memcheck findings in $out)"
    done < "$FAILED"
fi
fi

# --------------------------------------------------------------- summary ---
echo ""
echo "############ manifest ############"
column -s, -t < "$MANIFEST"

echo ""
echo "############ HOW TO READ IT ############"
echo "  1. Look at arm=none first. If it is clean and host/device are not, the"
echo "     staging change is implicated. If it fails too, the connector was"
echo "     already broken on this matrix and this experiment is blocked."
echo "  2. exit=3 means the harness caught the CUDA fault itself and printed"
echo "     the exact dataset/compressor pair on a [FATAL] line. Start there."
echo "  3. A cudaMalloc 'illegal memory access' is NOT an allocation failure."
echo "     It is a sticky context error from an earlier kernel. The harness now"
echo "     detects that and stops instead of blaming the next dataset."
echo "  4. Any [FAIL] fidelity line invalidates that pair's timings regardless"
echo "     of exit status."
echo ""
echo "results in: $RES"
echo "Job finished on $(date)"