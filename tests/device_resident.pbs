#!/bin/bash
#PBS -N g1_shared_ratio
#PBS -l select=1:ncpus=16:ngpus=1:mpiprocs=1:mem=128gb
#PBS -l walltime=03:00:00
#PBS -j oe
#PBS -A SDR
#PBS -q gpu

DATASET="${BENCH_DATASET:-s3d}"
COMP="${BENCH_COMP:-zstd}"
CHUNKS="${BENCH_CHUNKS:-8 64 512 2048 8192 32768}"

cd $PBS_O_WORKDIR/..
WORK="$(pwd)"
BUILD="build_g1"

echo "Job started on $(date)   host=$(hostname)"
echo "dataset=$DATASET comp=$COMP chunks=[$CHUNKS]"

module load gcc/11.4.0
module load hpcx/2.26-gcc
module load cuda/12.6.0

LP_VIEW=/home/kdougherty/libpressio_cuda/.spack-env/view
CLEAN_PATH=$(echo "$PATH" | tr ':' '\n' | grep -v spack-env | tr '\n' ':')
GCC_LIB=$(gcc --print-file-name=libstdc++.so | xargs dirname 2>/dev/null)
[ "$GCC_LIB" = "." ] && GCC_LIB=/usr/lib/gcc/x86_64-linux-gnu/11

echo ""
echo "=== [0] prerequisites ==="
HAVE_ZSTD=0; HAVE_ZDICT=0
"$LP_VIEW"/bin/pressio -a compressors 2>/dev/null | tr ' ' '\n' | grep -qx zstd \
    && { echo "  libpressio 'zstd' plugin: YES"; HAVE_ZSTD=1; } \
    || echo "  libpressio 'zstd' plugin: NO  (only reachable as blosc:compressor=zstd)"
[ -f "$LP_VIEW/include/zdict.h" ] \
    && { echo "  zdict.h: YES"; HAVE_ZDICT=1; } \
    || echo "  zdict.h: NO  -- dictionary provider cannot compile"

if [ "$HAVE_ZSTD" -eq 0 ]; then
    echo "  >>> falling back to COMP=blosc (set blosc:compressor=zstd in bench_config.h)"
    COMP="${BENCH_COMP_FALLBACK:-blosc}"
fi
if [ "$HAVE_ZDICT" -eq 0 ]; then
    echo "  >>> WARNING: shared and nodict will be IDENTICAL. Figure 1 cannot"
    echo "  >>> demonstrate contribution 3 in this configuration."
fi

SYSTEM_MPICC=$(which mpicc)
SYSTEM_MPICXX=$(which mpicxx)
[ -x "$SYSTEM_MPICC" ] || { echo "ERROR: mpicc not on PATH -- module load hpcx?"; exit 1; }

LP_CMAKE_DIR=""
for candidate in \
    "${LP_VIEW}/lib64/cmake/LibPressio" "${LP_VIEW}/lib/cmake/LibPressio" \
    "${LP_VIEW}/lib64/cmake/libpressio" "${LP_VIEW}/lib/cmake/libpressio"; do
    if [ -f "${candidate}/LibPressioConfig.cmake" ] || \
       [ -f "${candidate}/libpressio-config.cmake" ]; then
        LP_CMAKE_DIR="$candidate"; break
    fi
done
[ -z "$LP_CMAKE_DIR" ] && { echo "ERROR: no LibPressioConfig.cmake under $LP_VIEW"; exit 1; }

echo ""
echo "=== building ($BUILD) ==="

if [ -f "$BUILD/CMakeCache.txt" ]; then
    CACHED_CC=$(sed -n 's/^CMAKE_C_COMPILER:[^=]*=//p' "$BUILD/CMakeCache.txt")
    if [ "$CACHED_CC" != "$SYSTEM_MPICC" ]; then
        echo "  cache holds CC='$CACHED_CC', need '$SYSTEM_MPICC' -- clearing $BUILD"
        rm -rf "$BUILD"
    fi
fi

env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" \
cmake -S . -B "$BUILD" \
    -DCMAKE_C_COMPILER="$SYSTEM_MPICC" -DCMAKE_CXX_COMPILER="$SYSTEM_MPICXX" \
    -DUSE_CUDA=ON -DCMAKE_PREFIX_PATH="$LP_VIEW" \
    -DLibPressio_DIR="$LP_CMAKE_DIR" -Wno-dev \
    > build_g1.log 2>&1 || { echo "cmake failed"; tail -30 build_g1.log; exit 1; }
grep -q "zstd dictionary provider ENABLED" build_g1.log \
    && echo "  provider: COMPILED IN" || echo "  provider: NOT compiled in"
env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" cmake --build "$BUILD" -j16 \
    || { echo "build failed -- refusing to run a stale binary"; exit 1; }

VOL_BIN="$BUILD/tests/bench_vol_timing"
FLT_BIN="$BUILD/tests/bench_filter_timing"
VOL_PLUGIN_PATH="${VOL_PLUGIN_PATH:-$WORK/$BUILD/src}"
VOL_CONNECTOR="${VOL_CONNECTOR:-pass_through_ext under_vol=0;under_info={}}"
FILTER_PLUGIN_PATH="${FILTER_PLUGIN_PATH:-$WORK/tests/h5z_plugins}"
H5DIR="${VOL_H5DIR:-/lcrc/project/SDR/$USER/vol_bench_h5}"
mkdir -p "$H5DIR"

run_vol () {
    local arm="$1" N="$2" dis=""
    [ "$arm" = "nodict" ] && dis="VOL_SHARED_DISABLE=1"

    echo ""
    echo "--- [$arm] N=$N ---"
    local OUT
    OUT=$(env HDF5_PLUGIN_PATH="$VOL_PLUGIN_PATH" \
              HDF5_VOL_CONNECTOR="$VOL_CONNECTOR" \
              VOL_COMP_CHUNKING=shared VOL_COMP_CHUNK_N="$N" \
              VOL_COMP_CHUNK_LOG=1 ${dis:+$dis} \
              timeout --signal=KILL 1800 \
              "$VOL_BIN" --comp "$COMP" --only "$DATASET" \
                         --out /dev/null --ext /dev/null 2>&1)
    echo "$OUT"

    local ratio cbytes
    ratio=$(echo "$OUT" | grep -m1 '^\[shared\]' | sed -n 's/.*(\([0-9.]*\)x).*/\1/p')
    cbytes=$(echo "$OUT" | grep -m1 '^\[shared\]' | sed -n 's/.*total=\([0-9]*\) B.*/\1/p')
    [ -n "$ratio" ] && printf 'RESULT\t%s\t%s\t%s\t%s\n' "$arm" "$N" "$ratio" "${cbytes:-0}"
}

run_filter () {
    local N="$1"
    echo ""
    echo "--- [filter] N=$N ---"
    local h5="$H5DIR/g1_filter_N${N}.h5"
    local xcsv="/tmp/g1_flt_$$.csv"
    rm -f "$h5"

    env -u HDF5_VOL_CONNECTOR HDF5_PLUGIN_PATH="$FILTER_PLUGIN_PATH" \
        timeout --signal=KILL 1800 \
        "$FLT_BIN" --deflate --only "$DATASET" --chunk-n "$N" \
                   --h5 "$h5" --out /dev/null --ext "$xcsv" 2>&1
    rm -f "$h5"

    local line
    line=$(awk -F, 'FNR>1 && $5!="-1" {print $8"\t"$7; exit}' "$xcsv" 2>/dev/null)
    rm -f "$xcsv"
    [ -n "$line" ] && printf 'RESULT\tfilter\t%s\t%s\n' "$N" "$line"
}

echo ""
echo "############ sweep ############"
for N in $CHUNKS; do
    run_vol shared "$N"
    run_vol nodict "$N"
    run_filter     "$N"
done

echo ""
echo "############ RESULT lines above are the figure ############"
echo "plot with:  python3 plot_figures.py --fig1 <this-log>"
echo "Job finished on $(date)"