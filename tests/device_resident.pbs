#!/bin/bash
#PBS -N g2_device_resident
#PBS -l select=1:ncpus=16:ngpus=1:mpiprocs=1:mem=128gb
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -A SDR
#PBS -q gpu

DATASETS="miranda scale-T s3d nyx_baryon ocean_temp qmc"
COMP="zfp_gpu_r4 zfp_gpu_r8 zfp_gpu_r12 zfp_gpu_r16"

# nsys is a diagnostic, not a measurement: one dataset, one rate, both arms.
# Set RUN_NSYS=0 to skip it entirely once the HtoD delta has been confirmed.
RUN_NSYS="${RUN_NSYS:-1}"
NSYS_DATASET="${NSYS_DATASET:-miranda}"
NSYS_COMP="${NSYS_COMP:-zfp_gpu_r8}"

# Must match the geometry the rest of the figure was generated with, or the
# device bar is not comparable to the bars beside it. See the note at the end.
CHUNKING="${VOL_COMP_CHUNKING:-none}"

ARM_TIMEOUT="${ARM_TIMEOUT:-7200}"     # per arm, seconds; 2h of a 6h walltime

cd "$PBS_O_WORKDIR/.." || exit 1
WORK="$(pwd)"
BUILD="build_g2"

STAMP="$(date +%Y%m%d_%H%M%S)_${PBS_JOBID%%.*}"
RES="$WORK/devres_results/$STAMP"
PROF="$RES/nsys"
mkdir -p "$RES" "$PROF" || { echo "ERROR: cannot create $RES"; exit 1; }

echo "Job started on $(date)   host=$(hostname)"
echo "datasets=$DATASETS"
echo "comp=$COMP"
echo "chunking=$CHUNKING"
echo "results -> $RES"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader

module load gcc/11.4.0
module load hpcx/2.26-gcc
module load cuda/12.6.0

LP_VIEW=/home/kdougherty/libpressio_cuda/.spack-env/view
CLEAN_PATH=$(echo "$PATH" | tr ':' '\n' | grep -v spack-env | tr '\n' ':')
GCC_LIB=$(gcc --print-file-name=libstdc++.so | xargs dirname 2>/dev/null)
[ "$GCC_LIB" = "." ] && GCC_LIB=/usr/lib/gcc/x86_64-linux-gnu/11

SYSTEM_MPICC=$(which mpicc)
SYSTEM_MPICXX=$(which mpicxx)
[ -x "$SYSTEM_MPICC" ] || { echo "ERROR: mpicc not on PATH -- module load hpcx?"; exit 1; }

LP_CMAKE_DIR=""
for candidate in \
    "${LP_VIEW}/lib64/cmake/LibPressio" "${LP_VIEW}/lib/cmake/LibPressio" \
    "${LP_VIEW}/lib64/cmake/libpressio" "${LP_VIEW}/lib/cmake/libpressio"; do
    if [ -f "${candidate}/LibPressioConfig.cmake" ] || \
       [ -f "${candidate}/libpressio-config.cmake" ]; then
        LP_CMAKE_DIR="$candidate"; break
    fi
done
[ -z "$LP_CMAKE_DIR" ] && { echo "ERROR: no LibPressioConfig.cmake under $LP_VIEW"; exit 1; }

echo ""
echo "=== building ($BUILD) ==="

if [ -f "$BUILD/CMakeCache.txt" ]; then
    CACHED_CC=$(sed -n 's/^CMAKE_C_COMPILER:[^=]*=//p' "$BUILD/CMakeCache.txt")
    if [ "$CACHED_CC" != "$SYSTEM_MPICC" ]; then
        echo "  cache holds CC='$CACHED_CC', need '$SYSTEM_MPICC' -- clearing $BUILD"
        rm -rf "$BUILD"
    fi
fi

env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" \
cmake -S . -B "$BUILD" \
    -DCMAKE_C_COMPILER="$SYSTEM_MPICC" -DCMAKE_CXX_COMPILER="$SYSTEM_MPICXX" \
    -DUSE_CUDA=ON -DCMAKE_PREFIX_PATH="$LP_VIEW" \
    -DLibPressio_DIR="$LP_CMAKE_DIR" \
    -DBUILD_EXAMPLES=OFF -Wno-dev \
    > "$RES/build.log" 2>&1 || { echo "cmake failed"; tail -30 "$RES/build.log"; exit 1; }
env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" cmake --build "$BUILD" -j16 \
    >> "$RES/build.log" 2>&1 \
    || { echo "build failed -- refusing to run a stale binary";
         tail -40 "$RES/build.log"; exit 1; }

# The root CMakeLists sets CMAKE_RUNTIME_OUTPUT_DIRECTORY=${CMAKE_BINARY_DIR}/bin
# and LIBRARY_OUTPUT_DIRECTORY=${CMAKE_BINARY_DIR}/lib -- NOT the per-subdir
# defaults.
BIN="$BUILD/bin/bench_vol_timing"
VOL_PLUGIN_PATH="${VOL_PLUGIN_PATH:-$WORK/$BUILD/lib}"
VOL_CONNECTOR="${VOL_CONNECTOR:-pass_through_ext under_vol=0;under_info={}}"
[ -x "$BIN" ] || { echo "ERROR: $BIN not found after build"; exit 1; }

H5DIR="${VOL_H5DIR:-/lcrc/project/SDR/$USER/vol_bench_h5}"
mkdir -p "$H5DIR" || { echo "ERROR: cannot create $H5DIR"; exit 1; }

# bench_vol_timing has no --help; probe the binary for the env-var strings the
# staging block introduces. Absent => the source edit was never applied and
# both arms would run identically -- a null result that looks like a real one.
MISSING=""
for sym in BENCH_DEVICE_INPUT BENCH_HOST_STAGED BENCH_STAGING_CSV; do
    strings "$BIN" 2>/dev/null | grep -q "$sym" || MISSING="$MISSING $sym"
done
if [ -n "$MISSING" ]; then
    echo ""
    echo ">>> ERROR: $BIN is missing:$MISSING"
    echo ">>> Apply the staging block to bench_vol_timing.cc first. Without it"
    echo ">>> both arms run host-staged, the bars come out identical, and the"
    echo ">>> figure reports a savings of zero that is an artefact."
    exit 1
fi

# ---------------------------------------------------------------- one arm --
# The harness loops over datasets x compressors internally, so this is called
# ONCE per arm. BENCH_ONLY / BENCH_COMP take space-separated lists (see
# name_selected(), which treats ',' and ' ' as boundaries).
#
# COPY_LOG and GPU_EVENTS are deliberately OFF: both add work inside the timed
# H5Dwrite. Turn them on only for the diagnostic pass below.
run_arm () {
    local arm="$1"
    local dev=""
    case "$arm" in
        device) dev="BENCH_DEVICE_INPUT=1" ;;
        host)   dev="BENCH_HOST_STAGED=1"  ;;
        *)      echo "run_arm: bad arm '$arm'"; return 1 ;;
    esac

    echo ""
    echo "############ arm=$arm ############"
    local t0 rc
    t0=$(date +%s)

    env HDF5_PLUGIN_PATH="$VOL_PLUGIN_PATH" \
        HDF5_VOL_CONNECTOR="$VOL_CONNECTOR" \
        BENCH_ONLY="$DATASETS" BENCH_COMP="$COMP" \
        VOL_COMP_CHUNKING="$CHUNKING" \
        BENCH_STAGING_CSV="$RES/staging_${arm}.csv" \
        $dev \
        timeout --signal=KILL "$ARM_TIMEOUT" \
        "$BIN" "$H5DIR/g2_${arm}.h5" \
               "$RES/results_vol_${arm}.csv" \
               "$RES/results_vol_ext_${arm}.csv" \
        2>&1 | tee "$RES/arm_${arm}.log"
    rc=${PIPESTATUS[0]}

    echo "arm=$arm exit=$rc elapsed=$(( $(date +%s) - t0 ))s"
    [ "$rc" = 137 ] && echo ">>> arm=$arm hit the ${ARM_TIMEOUT}s timeout -- raise ARM_TIMEOUT"

    # Fidelity is the only thing that proves the device pointer was handled
    # correctly by the connector. A device buffer wrapped as host memory either
    # segfaults or compresses the wrong bytes; both surface here.
    local nfail
    nfail=$(grep -c '^\[FAIL\]' "$RES/arm_${arm}.log" 2>/dev/null || echo 0)
    if [ "$nfail" -gt 0 ]; then
        echo ""
        echo ">>> arm=$arm produced $nfail [FAIL] fidelity line(s). Do NOT plot"
        echo ">>> these timings -- the connector is not reading the buffer it"
        echo ">>> was handed. First few:"
        grep -m5 '^\[FAIL\]' "$RES/arm_${arm}.log" | sed 's/^/    /'
    fi
    return 0
}

echo ""
echo "############ [1] timing arms ############"
run_arm host
run_arm device

# --------------------------------------------------------------- summary ---
echo ""
echo "############ [2] row counts ############"
for arm in host device; do
    f="$RES/results_vol_ext_${arm}.csv"
    if [ -f "$f" ]; then
        printf '  %-7s %s rows (%s failure rows)\n' "$arm" \
            "$(( $(wc -l < "$f") - 1 ))" \
            "$(awk -F, 'NR>1 && $5==-1' "$f" | wc -l)"
    else
        echo "  $arm  MISSING -- arm did not complete"
    fi
done
echo ""
echo "  app-side D2H of the uncompressed field (host arm only):"
[ -f "$RES/staging_host.csv" ] && sed 's/^/    /' "$RES/staging_host.csv"

# ------------------------------------------------------------------ nsys ---
if [ "$RUN_NSYS" = "1" ]; then
echo ""
echo "############ [3] nsys profiles ($NSYS_DATASET / $NSYS_COMP) ############"

profile_arm () {
    local arm="$1"
    local dev=""
    [ "$arm" = "device" ] && dev="BENCH_DEVICE_INPUT=1"
    [ "$arm" = "host"   ] && dev="BENCH_HOST_STAGED=1"
    local out="$PROF/g2_${arm}"

    echo ""
    echo "--- nsys [$arm] ---"
    env HDF5_PLUGIN_PATH="$VOL_PLUGIN_PATH" \
        HDF5_VOL_CONNECTOR="$VOL_CONNECTOR" \
        BENCH_ONLY="$NSYS_DATASET" BENCH_COMP="$NSYS_COMP" \
        VOL_COMP_CHUNKING="$CHUNKING" \
        VOL_COMP_COPY_LOG=1 VOL_COMP_GPU_EVENTS=1 \
        $dev \
    nsys profile \
        --trace=cuda,nvtx,osrt \
        --cuda-memory-usage=true \
        --force-overwrite=true \
        -o "$out" \
        "$BIN" "$H5DIR/g2_prof_${arm}.h5" \
               "$PROF/prof_${arm}.csv" "$PROF/prof_ext_${arm}.csv" \
        > "$out.stdout" 2>&1
    echo "  wrote $out.nsys-rep"

    rm -f "$out.sqlite"
    echo "  --- transfers / sizes / kernels ---"
    nsys stats --force-export=true --format table \
        --report cuda_gpu_mem_time_sum \
        --report cuda_gpu_mem_size_sum \
        --report cuda_gpu_kern_sum \
        "$out.nsys-rep" 2>&1 | sed 's/^/    /'
}

profile_arm host
profile_arm device
fi

echo ""
echo "############ HOW TO READ IT ############"
echo "  [CUDA memcpy HtoD] on the host arm should be ~= the logical dataset"
echo "  size (the connector re-uploading what the app just downloaded). On the"
echo "  device arm the input HtoD should be ~0. That delta is the overhead a"
echo "  filter cannot avoid, because H5Z only ever sees host bytes."
echo ""
echo "  If BOTH arms show the same HtoD, the VOL is not honouring the device"
echo "  pointer -- it is staging through host memory internally. Fix the"
echo "  connector, not the plot."
echo ""
echo "  CHUNKING: this ran with VOL_COMP_CHUNKING=$CHUNKING. The rest of the"
echo "  figure uses VOL config 'native' for every dataset except qmc, which"
echo "  uses vol_N8. If '$CHUNKING' is not the same geometry, the device bar is"
echo "  not comparable to the bars beside it -- rerun with the matching value."
echo ""
echo "results in: $RES"
echo "profiles in: $PROF   (open .nsys-rep in the Nsight Systems GUI)"
echo "Job finished on $(date)"