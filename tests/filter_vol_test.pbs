#!/bin/bash
#PBS -N vol_shared_meta
#PBS -l select=1:ncpus=16:ngpus=1:mpiprocs=1:mem=128gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -A SDR
#PBS -q gpu

DATASET="${BENCH_DATASET:-s3d}"
COMP="${BENCH_COMP:-zstd}"
CHUNK_COUNTS="${BENCH_CHUNKS:-1 8 64 512 4096 32768}"

: "${DATASET:?config error: DATASET empty}"
: "${COMP:?config error: COMP empty}"

cd $PBS_O_WORKDIR/..
WORK="$(pwd)"
BUILD="build_shared"
BIN="$BUILD/tests/bench_vol_timing"

echo "Job started on $(date)"
echo "Running on : $(hostname)"
echo "Dataset    : $DATASET"
echo "Compressor : $COMP"
echo "Chunk ladder: $CHUNK_COUNTS"
echo "Build dir  : $BUILD"

module load gcc/11.4.0
module load hpcx/2.26-gcc
module load cuda/12.6.0

SYSTEM_MPICC=$(which mpicc)
SYSTEM_MPICXX=$(which mpicxx)
GCC_LIB=$(gcc --print-file-name=libstdc++.so | xargs dirname 2>/dev/null)
[ "$GCC_LIB" = "." ] && GCC_LIB=/usr/lib/gcc/x86_64-linux-gnu/11

LP_VIEW=/home/kdougherty/libpressio_cuda/.spack-env/view

LP_CMAKE_DIR=""
for candidate in \
    "${LP_VIEW}/lib64/cmake/LibPressio" "${LP_VIEW}/lib/cmake/LibPressio" \
    "${LP_VIEW}/lib64/cmake/libpressio" "${LP_VIEW}/lib/cmake/libpressio"; do
    if [ -f "${candidate}/LibPressioConfig.cmake" ] || \
       [ -f "${candidate}/libpressio-config.cmake" ]; then
        LP_CMAKE_DIR="$candidate"; break
    fi
done
[ -z "$LP_CMAKE_DIR" ] && { echo "ERROR: no LibPressioConfig.cmake under $LP_VIEW"; exit 1; }

CLEAN_PATH=$(echo "$PATH" | tr ':' '\n' | grep -v spack-env | tr '\n' ':')

echo ""
echo "=== [0] zstd dictionary API availability ==="
for f in "$LP_VIEW/include/zdict.h" "$LP_VIEW/include/zstd.h"; do
    if [ -f "$f" ]; then echo "  FOUND   $f"; else echo "  MISSING $f"; fi
done
ls -1 "$LP_VIEW"/lib*/libzstd.so* 2>/dev/null | head -3 | sed 's/^/  lib:    /'
echo "  supported compressors (filtered):"
"$LP_VIEW"/bin/pressio -a compressors 2>/dev/null | tr ' ' '\n' \
    | grep -iE 'zstd|roibin|mgard|blosc|sz3' | sed 's/^/    /' \
    || echo "    (pressio CLI unavailable -- check by hand)"

echo ""
echo "=== Building ($BUILD) ==="
env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" \
cmake -S . -B "$BUILD" \
    -DCMAKE_C_COMPILER="$SYSTEM_MPICC" -DCMAKE_CXX_COMPILER="$SYSTEM_MPICXX" \
    -DUSE_CUDA=ON -DCMAKE_PREFIX_PATH="$LP_VIEW" \
    -DLibPressio_DIR="$LP_CMAKE_DIR" -Wno-dev 2>&1 | tee build_shared_config.log

# The CMake probe in INTEGRATION_shared_meta.md prints one of these two lines.
if grep -q "zstd dictionary provider ENABLED" build_shared_config.log; then
    echo ""
    echo ">>> zstd-dict provider COMPILED IN. shared vs nodict is meaningful."
    PROVIDER_OK=1
else
    echo ""
    echo ">>> WARNING: zstd-dict provider NOT compiled in."
    echo ">>> 'shared' and 'nodict' will produce IDENTICAL results and this"
    echo ">>> sweep cannot demonstrate contribution 3. Fix zdict.h discovery."
    PROVIDER_OK=0
fi

env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" cmake --build "$BUILD" -j16 \
  || { echo "ERROR: build failed -- refusing to run a stale binary"; exit 1; }

[ -x "$BIN" ] || { echo "ERROR: $BIN not built"; exit 1; }

VOL_PLUGIN_PATH="${VOL_PLUGIN_PATH:-$WORK/$BUILD/src}"
VOL_CONNECTOR="${VOL_CONNECTOR:-pass_through_ext under_vol=0;under_info={}}"

echo ""
echo "=== VOL activation ==="
echo "  HDF5_PLUGIN_PATH   = $VOL_PLUGIN_PATH"
echo "  HDF5_VOL_CONNECTOR = $VOL_CONNECTOR"
ls -1 "$VOL_PLUGIN_PATH"/*.so 2>/dev/null | sed 's/^/  so: /' \
    || echo "  WARNING: no .so found there -- fix VOL_PLUGIN_PATH"

SUMMARY=""

run_vol () {
    local arm="$1"; local N="$2"
    local mode="shared"
    local disable=""

    case "$arm" in
        shared) mode="shared";                    disable="" ;;
        nodict) mode="shared"; disable="VOL_SHARED_DISABLE=1" ;;
        vol)    mode="vol";                       disable="" ;;
    esac

    echo ""
    echo "=== [$arm] $DATASET  $COMP  N=$N  (chunking=$mode ${disable:-}) ==="
    local t0=$SECONDS

    local OUT
    OUT=$(env HDF5_PLUGIN_PATH="$VOL_PLUGIN_PATH" \
              HDF5_VOL_CONNECTOR="$VOL_CONNECTOR" \
              VOL_COMP_CHUNKING="$mode" \
              VOL_COMP_CHUNK_N="$N" \
              VOL_COMP_CHUNK_LOG=1 \
              ${disable:+$disable} \
              timeout --signal=KILL "${VOL_TIMEOUT:-1800}" \
              "$BIN" --comp "$COMP" --only "$DATASET" \
                     --out /dev/null --ext /dev/null 2>&1)
    local rc=$?
    local dt=$(( SECONDS - t0 ))

    echo "$OUT"
    echo "  [time] $arm N=$N took ${dt}s (rc=$rc)"

    # Pull the ratio straight out of the "[shared]" log line; fall back to the
    # "[chunk-out]" lines for the vol arm, which has no container summary.
    local line
    line=$(echo "$OUT" | grep -m1 '^\[shared\]')
    if [ -n "$line" ]; then
        SUMMARY="${SUMMARY}
$(printf '  %-7s N=%-7s %s' "$arm" "$N" "$line")"
    else
        local tot
        tot=$(echo "$OUT" | awk '/\[chunk-out\]/ {n++; split($0,a," -> "); }
                                 END {printf "%d chunk(s)", n}')
        SUMMARY="${SUMMARY}
$(printf '  %-7s N=%-7s (no container line; %s)' "$arm" "$N" "$tot")"
    fi
}

echo ""
echo "############ shared-metadata sweep: $DATASET / $COMP ############"
for N in $CHUNK_COUNTS; do
    run_vol shared "$N"
    run_vol nodict "$N"
    run_vol vol    "$N"
done

echo ""
echo "############################################################"
echo "RECAP -- ratio is the trailing (N.NNNx) on each [shared] line"
echo "############################################################"
echo "$SUMMARY"
echo ""
echo "READ IT LIKE THIS:"
echo "  shared vs nodict  -> the dictionary's contribution. Should widen as N grows."
echo "  nodict vs vol     -> container overhead only. Should be ~flat/equal."
echo "  If shared == nodict everywhere, the provider did not engage:"
echo "    check the [0] section above and the 'trained ... dictionary' log line."
[ "$PROVIDER_OK" -eq 0 ] && \
  echo "  *** provider was NOT compiled in -- this run cannot show contribution 3 ***"

echo ""
echo "Job finished on $(date)"