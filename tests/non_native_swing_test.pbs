#!/bin/bash
#PBS -N vol_test_swing
#PBS -l select=1:ncpus=4:ngpus=1:mpiprocs=1:mem=8gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -A SDR
#PBS -q gpu

cd $PBS_O_WORKDIR/..
WORK="$(pwd)/tests"

echo "Job started on $(date)"
echo "Running on: $(hostname)"
echo "PWD: $(pwd)"

module load gcc/11.4.0
module load hpcx/2.26-gcc
module load cuda/12.6.0

SYSTEM_MPICC=$(which mpicc)
SYSTEM_MPICXX=$(which mpicxx)
GCC_LIB=$(gcc --print-file-name=libstdc++.so | xargs dirname 2>/dev/null)
[ "$GCC_LIB" = "." ] && GCC_LIB=/usr/lib/gcc/x86_64-linux-gnu/11

echo "mpicc:   $SYSTEM_MPICC"
echo "nvcc:    $(which nvcc)"
echo "gcc:     $(gcc --version | head -1)"
echo "GCC_LIB: $GCC_LIB"

$SYSTEM_MPICC --version || { echo "mpicc broken — aborting"; exit 1; }

LP_VIEW=/home/kdougherty/libpressio_cuda/.spack-env/view

# Find LibPressio cmake config — check both lib and lib64
LP_CMAKE_DIR=""
for candidate in \
    "${LP_VIEW}/lib64/cmake/LibPressio" \
    "${LP_VIEW}/lib/cmake/LibPressio" \
    "${LP_VIEW}/lib64/cmake/libpressio" \
    "${LP_VIEW}/lib/cmake/libpressio"
do
    if [ -f "${candidate}/LibPressioConfig.cmake" ] || \
       [ -f "${candidate}/libpressio-config.cmake" ]; then
        LP_CMAKE_DIR="$candidate"
        break
    fi
done

if [ -z "$LP_CMAKE_DIR" ]; then
    echo "ERROR: Cannot find LibPressioConfig.cmake under $LP_VIEW"
    echo "--- cmake dirs in view ---"
    find "$LP_VIEW" -name "*ressio*onfig.cmake" 2>/dev/null
    exit 1
fi
echo "LibPressio cmake dir: $LP_CMAKE_DIR"

CLEAN_PATH=$(echo "$PATH" | tr ':' '\n' | grep -v spack-env | tr '\n' ':')

echo ""
echo "=== Building (USE_CUDA=ON -> CUDA-event timing in the connector) ==="
rm -rf build
env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" \
cmake -S . -B build \
    -DCMAKE_C_COMPILER="$SYSTEM_MPICC" \
    -DCMAKE_CXX_COMPILER="$SYSTEM_MPICXX" \
    -DUSE_CUDA=ON \
    -DCMAKE_PREFIX_PATH="$LP_VIEW" \
    -DLibPressio_DIR="$LP_CMAKE_DIR" \
    -Wno-dev

env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" \
cmake --build build -j4

echo "--- build/ ---"
ls build/ || { echo "Build failed"; exit 1; }
echo "--- build/tests/ ---"
ls build/tests/ || { echo "No tests/ in build"; exit 1; }

export LD_LIBRARY_PATH=${GCC_LIB}:${LP_VIEW}/lib64:${LP_VIEW}/lib

export HDF5_USE_FILE_LOCKING=FALSE
rm -f "$WORK/bench_out.h5"        # clear any stale/half-written file

# Which datasets to sweep
# export BENCH_ONLY="miranda,hurricane,s3d"

echo ""
echo "=== [0/3] Dump cuszp option keys ==="
./build/tests/dump_cuszp_opts | tr ',' '\n' | grep -i cuszp

PLUGIN_DIR="$(pwd)/build"

# ---------------------------------------------------------------------------
# run_vol_group TAG SEL COMP MODE NCHUNKS
#   MODE:     "" = native (no chunking, default)
#             "vol"     = VOL-level chunking      (VOL_COMP_CHUNKING=vol)
#             "pressio" = libpressio chunking meta (VOL_COMP_CHUNKING=pressio)
#   NCHUNKS: number of equal chunks for vol/pressio modes; "" = single chunk (N=1)
# The env vars override any vol:* keys in opts_json, so the *_pjson JSON-path
# runs below must be launched with MODE="" and NCHUNKS="".
# ---------------------------------------------------------------------------
# put the big, disposable .h5 files on your SDR project allocation, not home
H5DIR="${VOL_H5DIR:-/lcrc/project/SDR/$USER/vol_bench_h5}"
mkdir -p "$H5DIR" || { echo "cannot create $H5DIR"; exit 1; }

run_vol_group () {
    local tag="$1"; local sel="$2"; local comp="$3"; local mode="$4"; local nchunks="$5"
    local label="${tag}_${comp}_${mode:-native}${nchunks:+_N${nchunks}}"
    local h5="$H5DIR/bench_${label}.h5"          # big file off the quota'd home dir
    local rcsv="$WORK/results_vol_${label}.csv"  # small CSVs stay in tests/
    local pcsv="$WORK/connector_phases_${label}.csv"
    rm -f "$h5"
    echo ""
    echo "=== [1/3] VOL timing [$label] : $sel (chunking: ${mode:-native}${nchunks:+, N=${nchunks}}) ==="
    env HDF5_VOL_CONNECTOR="pass_through_ext under_vol=0;under_info={}" \
        HDF5_PLUGIN_PATH="$PLUGIN_DIR" \
        HDF5_VOL_DUMP_PIPELINE=1 \
        VOL_COMP_CHUNK_LOG=1 \
        ${mode:+VOL_COMP_CHUNKING="$mode"} \
        ${nchunks:+VOL_COMP_CHUNK_N="$nchunks"} \
        BENCH_ONLY="$sel" \
        BENCH_COMP="$comp" \
        BENCH_CSV="$pcsv" \
        timeout --signal=KILL 900 ./build/tests/bench_vol_timing "$h5" "$rcsv"
    local rc=$?
    rm -f "$h5"                                  # reclaim space EVERY time, even on failure/timeout
    [ $rc -eq 137 ] && echo "  [warn] $label killed by timeout — moving on"
    [ $rc -ne 0 ]  && echo "  [warn] $label exited rc=$rc — moving on"
    return 0                                     # never let one run abort the sweep
}

declare -A DATASET=(
  [miranda]=miranda   [ocean_temp]=ocean_temp  [qmc]=einspline37
  [scale-T]=scale-T   [s3d]=s3d                [nyx_baryon]=nyx_baryon )

# Chunk sizes are per-dataset so both actually chunk:
#   miranda     = 288 MiB  -> 64/128 MB gives 5/3 chunks (64 exercises a ragged tail)
#   einspline37 = ~12.6 GiB -> 4000/5000 MB gives 4/3 chunks (old sweep values)
CHUNK_COUNTS="8 16"

# noop cuszp_1e3 cuszp_1e6 sz3_1e3 sz3_1e6
for comp in noop cuszp_1e3 cuszp_1e6 sz3_1e3 sz3_1e6; do
    # native baseline (no chunking of any kind — the default path)
    run_vol_group miranda "miranda"     "$comp" "" ""
    run_vol_group ocean_temp     "ocean_temp" "$comp" "" ""
    run_vol_group qmc     "einspline37" "$comp" "" ""
    run_vol_group scale-T "scale-T"     "$comp" "" ""
    run_vol_group s3d "s3d"     "$comp" "" ""
    run_vol_group nyx_baryon "nyx_baryon"     "$comp" "" ""

    for mode in vol pressio; do
        # the VOL rejects noop under pressio chunking by design — skip, don't fail
        if [ "$comp" = "noop" ] && [ "$mode" = "pressio" ]; then
            echo ""
            echo "=== skip: noop x pressio (rejected by the VOL by design) ==="
            continue
        fi
        for g in miranda ocean_temp qmc scale-T s3d nyx_baryon; do
            for N in $CHUNK_COUNTS; do
                run_vol_group "$g" "${DATASET[$g]}" "$comp" "$mode" "$N"
            done
        done
    done
done

# ---------------------------------------------------------------------------
# JSON-path validation: chunking selected via opts_json ("vol:chunking_mode",
# "vol:chunk_n") with NO env override. This exercises the full persistence
# chain: DCPL JSON -> parse at ctx create -> _VOL_OPTIONS_JSON snapshot ->
# replay+parse at dataset_open. Entries defined in bench_config.h.
# ---------------------------------------------------------------------------
echo ""
echo "=== JSON-path chunking selection (no VOL_COMP_* env set) ==="
for comp in sz3_1e3_vjson sz3_1e3_pjson; do
    run_vol_group miranda "miranda"     "$comp" "" ""
    run_vol_group qmc     "einspline37" "$comp" "" ""
done

# echo ""
# echo "=== [2/3] Pressio-only compressor timing ==="
# ./build/tests/bench_pressio_timing "$WORK/payload.bin" "$WORK/results_pressio.csv"

echo ""
echo "=== [3/3] Filter (deflate) timing ==="
./build/tests/bench_filter_timing --deflate \
    --h5 "$WORK/bench_filter.h5" --out "$WORK/results_filter.csv"

# Summaries: iterate whatever labels actually ran (labels now encode mode+size)
for pcsv in "$WORK"/connector_phases_*.csv; do
    [ -f "$pcsv" ] || continue
    label=$(basename "$pcsv" .csv); label=${label#connector_phases_}
    echo ""
    echo "=== [$label] connector_phases (VOL total/compress/io) ==="
    column -t -s, "$pcsv"
    if [ -f "$WORK/results_vol_${label}.csv" ]; then
        echo ""
        echo "=== [$label] results_vol (harness total + ratio + RMSE) ==="
        column -t -s, "$WORK/results_vol_${label}.csv"
    fi
done

echo ""
echo "=== FILE-LEVEL summary (phase=file, per group × codec) ==="
grep -h ',file,' "$WORK"/results_vol_*.csv 2>/dev/null | sort || echo "(no file rows)"

# echo "=== results_pressio.csv ==="
# column -t -s, "$WORK/results_pressio.csv"
# echo ""

echo "=== results_filter.csv ==="
column -t -s, "$WORK/results_filter.csv"

echo ""
echo "Job finished on $(date)"
