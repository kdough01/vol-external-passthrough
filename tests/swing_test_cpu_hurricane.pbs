#!/bin/bash
#PBS -N vol_test_swing
#PBS -l select=1:ncpus=4:ngpus=1:mpiprocs=1:mem=8gb
#PBS -l walltime=00:15:00
#PBS -j oe
#PBS -A SDR
#PBS -q gpu

cd $PBS_O_WORKDIR/..
WORK="$(pwd)/tests"

echo "Job started on $(date)"
echo "Running on: $(hostname)"
echo "PWD: $(pwd)"

module load gcc/11.4.0
module load hpcx/2.26-gcc
module load cuda/12.6.0

SYSTEM_MPICC=$(which mpicc)
SYSTEM_MPICXX=$(which mpicxx)
GCC_LIB=$(gcc --print-file-name=libstdc++.so | xargs dirname 2>/dev/null)
[ "$GCC_LIB" = "." ] && GCC_LIB=/usr/lib/gcc/x86_64-linux-gnu/11

echo "mpicc:   $SYSTEM_MPICC"
echo "nvcc:    $(which nvcc)"
echo "gcc:     $(gcc --version | head -1)"
echo "GCC_LIB: $GCC_LIB"

$SYSTEM_MPICC --version || { echo "mpicc broken — aborting"; exit 1; }

LP_VIEW=/home/kdougherty/libpressio_cuda/.spack-env/view

# Find LibPressio cmake config — check both lib and lib64
LP_CMAKE_DIR=""
for candidate in \
    "${LP_VIEW}/lib64/cmake/LibPressio" \
    "${LP_VIEW}/lib/cmake/LibPressio" \
    "${LP_VIEW}/lib64/cmake/libpressio" \
    "${LP_VIEW}/lib/cmake/libpressio"
do
    if [ -f "${candidate}/LibPressioConfig.cmake" ] || \
       [ -f "${candidate}/libpressio-config.cmake" ]; then
        LP_CMAKE_DIR="$candidate"
        break
    fi
done

if [ -z "$LP_CMAKE_DIR" ]; then
    echo "ERROR: Cannot find LibPressioConfig.cmake under $LP_VIEW"
    echo "--- cmake dirs in view ---"
    find "$LP_VIEW" -name "*ressio*onfig.cmake" 2>/dev/null
    exit 1
fi
echo "LibPressio cmake dir: $LP_CMAKE_DIR"

CLEAN_PATH=$(echo "$PATH" | tr ':' '\n' | grep -v spack-env | tr '\n' ':')

echo ""
echo "=== Building (USE_CUDA=ON -> CUDA-event timing in the connector) ==="
rm -rf build
env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" \
cmake -S . -B build \
    -DCMAKE_C_COMPILER="$SYSTEM_MPICC" \
    -DCMAKE_CXX_COMPILER="$SYSTEM_MPICXX" \
    -DUSE_CUDA=ON \
    -DCMAKE_PREFIX_PATH="$LP_VIEW" \
    -DLibPressio_DIR="$LP_CMAKE_DIR" \
    -Wno-dev

env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" \
cmake --build build -j4

echo "--- build/ ---"
ls build/ || { echo "Build failed"; exit 1; }
echo "--- build/tests/ ---"
ls build/tests/ || { echo "No tests/ in build"; exit 1; }

export LD_LIBRARY_PATH=${GCC_LIB}:${LP_VIEW}/lib64:${LP_VIEW}/lib

export HDF5_USE_FILE_LOCKING=FALSE
rm -f "$WORK/bench_out.h5"        # clear any stale/half-written file

# Which datasets to sweep
# export BENCH_ONLY="miranda,hurricane,s3d"

echo ""
echo "=== [0/3] Dump cuszp option keys ==="
./build/tests/dump_cuszp_opts | tr ',' '\n' | grep -i cuszp

PLUGIN_DIR="$(pwd)/build"

run_vol_group () {
    local tag="$1"; local sel="$2"; local comp="$3"
    local label="${tag}_${comp}"
    local h5="$WORK/bench_${label}.h5"
    local rcsv="$WORK/results_vol_${label}.csv"
    local pcsv="$WORK/connector_phases_${label}.csv"
    rm -f "$h5"
    echo ""
    echo "=== [1/3] VOL timing [$label] : $sel ==="
    env HDF5_VOL_CONNECTOR="pass_through_ext under_vol=0;under_info={}" \
        HDF5_PLUGIN_PATH="$PLUGIN_DIR" \
        BENCH_ONLY="$sel" \
        BENCH_COMP="$comp" \
        BENCH_CSV="$pcsv" \
        ./build/tests/bench_vol_timing "$h5" "$rcsv"
}

for comp in noop cuszp sz3_1e3 sz3_1e6 bzip2; do
    run_vol_group miranda "miranda" "$comp"
    run_vol_group ocean   "ocean_temp" "$comp"
    run_vol_group qmc     "einspline37" "$comp"
    run_vol_group nyx "nyx_baryon,nyx_dm,nyx_temp_log,nyx_vx_asinh,nyx_vy_asinh,nyx_vz_asinh" "$comp"
done
# echo ""
# echo "=== [2/3] Pressio-only compressor timing ==="
# ./build/tests/bench_pressio_timing "$WORK/payload.bin" "$WORK/results_pressio.csv"

echo ""
echo "=== [3/3] Filter (deflate) timing ==="
./build/tests/bench_filter_timing --deflate \
    --h5 "$WORK/bench_filter.h5" --out "$WORK/results_filter.csv"

for tag in miranda ocean nyx nyx_log; do
    echo ""
    echo "=== [$tag] connector_phases (VOL total/compress/io) ==="
    [ -f "$WORK/connector_phases_${tag}.csv" ] && column -t -s, "$WORK/connector_phases_${tag}.csv"
    echo ""
    echo "=== [$tag] results_vol (harness total + ratio + RMSE) ==="
    [ -f "$WORK/results_vol_${tag}.csv" ] && column -t -s, "$WORK/results_vol_${tag}.csv"
done

echo ""
echo "=== FILE-LEVEL summary (phase=file, per group × codec) ==="
grep -h ',file,' "$WORK"/results_vol_*.csv 2>/dev/null | sort || echo "(no file rows)"

# echo "=== results_pressio.csv ==="
# column -t -s, "$WORK/results_pressio.csv"
# echo ""

echo "=== results_filter.csv ==="
column -t -s, "$WORK/results_filter.csv"

echo ""
echo "Job finished on $(date)"
