#!/bin/bash
#PBS -N vol_test_swing
#PBS -l select=1:ncpus=4:ngpus=1:mpiprocs=1
#PBS -l walltime=00:10:00
#PBS -j oe
#PBS -A ECP-EZ
#PBS -q gpu

cd $PBS_O_WORKDIR

echo "Job started on $(date)"
echo "Running on: $(hostname)"

# Load
module load gcc/9.2.0-r4tyw54
module load cuda/11.4.0-gqbcqie
module load openmpi/5.1.0-cuda-ucx

echo "mpicc: $(which mpicc)"
echo "nvcc:  $(which nvcc)"
echo "gcc:   $(gcc --version | head -1)"

LP_VIEW=/lcrc/project/ECP-EZ/public/compression/libpressio/libpressio_env/.spack-env/view

# Build
echo ""
echo "=== Building ==="
rm -rf build
env -u LD_LIBRARY_PATH \
cmake -S . -B build \
    -DCMAKE_C_COMPILER=mpicc \
    -DCMAKE_CXX_COMPILER=mpicxx \
    -DUSE_CUDA=ON \
    -DCMAKE_PREFIX_PATH="$LP_VIEW" \
    -Wno-dev

env -u LD_LIBRARY_PATH \
cmake --build build -j4

echo "--- build/ contents ---"
ls build/ || { echo "Build failed"; exit 1; }

GCC_LIB=$(gcc -print-file-name=libstdc++.so | xargs dirname)
export LD_LIBRARY_PATH=${GCC_LIB}:${LP_VIEW}/lib64:${LP_VIEW}/lib

export HDF5_VOL_CONNECTOR="pass_through_ext under_vol=0;under_info={}"
export HDF5_PLUGIN_PATH=$(pwd)/build

echo ""
echo "=== Small write test (bzip2 / sz3 / zfp) ==="
./build/test_write

echo ""
echo "=== Hurricane GPU test ==="
./build/test_hurricane_gpu

echo "Job finished on $(date)"