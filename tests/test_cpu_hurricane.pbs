#!/bin/bash
#PBS -N swing_diag
#PBS -l select=1:ncpus=4:ngpus=1:mpiprocs=1
#PBS -l walltime=00:05:00
#PBS -j oe
#PBS -A ECP-EZ
#PBS -q gpu

cd $PBS_O_WORKDIR

echo "=== hostname ==="
hostname

echo "=== /lcrc/project/ECP-EZ/public/compression/libpressio/ ==="
ls /lcrc/project/ECP-EZ/public/compression/libpressio/

echo "=== use_spack.sh contents ==="
cat /lcrc/project/ECP-EZ/public/compression/libpressio/use_spack.sh

echo "=== module avail (mpi) ==="
module avail 2>&1 | grep -i mpi

echo "=== module avail (cuda) ==="
module avail 2>&1 | grep -i cuda

echo "=== module avail (gcc) ==="
module avail 2>&1 | grep -i gcc

echo "=== which mpicc after source ==="
source /lcrc/project/ECP-EZ/public/compression/libpressio/use_spack.sh 2>&1 || true
which mpicc 2>/dev/null || echo "mpicc not found"
mpicc --version 2>/dev/null || true

echo "=== nvcc ==="
which nvcc 2>/dev/null || echo "nvcc not found"
nvcc --version 2>/dev/null || true

echo "=== python version in spack ==="
python3 --version 2>/dev/null || true

echo "Done"