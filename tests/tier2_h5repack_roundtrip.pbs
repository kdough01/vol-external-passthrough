#!/bin/bash
#PBS -N vol_h5repack_roundtrip
#PBS -l select=1:ncpus=8:ngpus=1
#PBS -l walltime=00:05:00
#PBS -q gpu
#PBS -A SDR
#PBS -j oe

# ====================== PATHS ======================
SPACK_ROOT="/home/kdougherty/spack"
LP_VIEW="/home/kdougherty/libpressio_cuda/.spack-env/view"
VOL_BUILD_DIR="/home/kdougherty/hdf5_projs/vol-external-passthrough/build"
CACHE_DIR="/lcrc/project/SDR/kdougherty/ci/h5repack_roundtrip"
NATIVE_H5="$CACHE_DIR/native_density.h5"
WORK="$CACHE_DIR/job_${PBS_JOBID:-local}"

mkdir -p "$WORK" "$CACHE_DIR"
cd "$WORK"

ulimit -c unlimited

echo "=== Environment Setup ==="
module purge
module load gcc/11.4.0
module load hpcx/2.26-gcc
module load cuda/12.6.0

source "$SPACK_ROOT/share/spack/setup-env.sh"

export PATH="${LP_VIEW}/bin:${PATH}"
export LD_LIBRARY_PATH="/usr/lib/gcc/x86_64-linux-gnu/11:${LP_VIEW}/lib64:${LP_VIEW}/lib:${LD_LIBRARY_PATH:-}"
export HDF5_PLUGIN_PATH="$VOL_BUILD_DIR"

VOL_NAME="pass_through_ext"

echo "h5repack: $(which h5repack)"
h5repack --version
echo "VOL library: $VOL_BUILD_DIR/libhdf5_vol_passthrough.so"
ls -l "$VOL_BUILD_DIR/libhdf5_vol_passthrough.so"

if [[ ! -f "$NATIVE_H5" ]]; then
  echo "== ingesting $FIELD_FILE -> $NATIVE_H5 =="
  cat > ingest.c <<'EOF'
#include "hdf5.h"
#include <stdio.h>
#include <stdlib.h>
int main(int argc, char **argv) {
    if (argc != 7) { fprintf(stderr, "usage: ingest raw out dset nx ny nz\n"); return 2; }
    const char *raw = argv[1], *out = argv[2], *dset = argv[3];
    hsize_t nx = strtoull(argv[4], 0, 10);
    hsize_t ny = strtoull(argv[5], 0, 10);
    hsize_t nz = strtoull(argv[6], 0, 10);
    hsize_t n = nx * ny * nz;
    double *buf = (double *) malloc(n * sizeof(double));
    if (!buf) { fprintf(stderr, "malloc failed\n"); return 3; }
    FILE *f = fopen(raw, "rb");
    if (!f) { perror("fopen"); return 3; }
    if (fread(buf, sizeof(double), n, f) != n) { fprintf(stderr, "short read\n"); return 3; }
    fclose(f);
    hid_t fid = H5Fcreate(out, H5F_ACC_TRUNC, H5P_DEFAULT, H5P_DEFAULT);
    hsize_t dims[3] = {nx, ny, nz};
    hid_t sid = H5Screate_simple(3, dims, NULL);
    hid_t dcpl = H5Pcreate(H5P_DATASET_CREATE);
    hsize_t chunk[3] = {nx, ny, nz};   /* single full-dataset chunk; tune if desired */
    H5Pset_chunk(dcpl, 3, chunk);
    hid_t did = H5Dcreate2(fid, dset, H5T_IEEE_F64LE, sid, H5P_DEFAULT, dcpl, H5P_DEFAULT);
    H5Dwrite(did, H5T_NATIVE_DOUBLE, H5S_ALL, H5S_ALL, H5P_DEFAULT, buf);
    H5Dclose(did); H5Pclose(dcpl); H5Sclose(sid); H5Fclose(fid); free(buf);
    return 0;
}
EOF
  h5cc -O2 ingest.c -o ingest
  ./ingest "$MIRANDA_DIR/$FIELD_FILE" "$NATIVE_H5" "$DSET" "$NX" "$NY" "$NZ"
fi
echo "native source size: $(stat -c%s "$NATIVE_H5") bytes"

FAILS=0
declare -a SUMMARY=()

roundtrip () {
  local comp="$1" mode="$2"
  local comp_h5="comp_${comp}.h5"
  local dec_h5="dec_${comp}.h5"

  echo "============================================================"
  echo "== compressor: $comp   (mode: $mode) =="

  # Critical: clean VOL state
  export HDF5_VOL_CONNECTOR="pass_through_ext under_vol=1;under_info={}"

  export HDF5_VOL_PRESSIO_COMPRESSOR="$comp"
  [[ "$mode" != "lossless" ]] && export HDF5_VOL_PRESSIO_LEVEL="$mode"

  echo "  [1/3] Compressing with --dst-vol-name..."
  if ! "${LP_VIEW}/bin/h5repack" --dst-vol-name="$VOL_NAME" --enable-error-stack \
       "$NATIVE_H5" "$comp_h5"; then
    echo "  [FAIL] compress failed"
    return 1
  fi

  echo "  [2/3] Decompressing with --src-vol-name..."
  if ! "${LP_VIEW}/bin/h5repack" --src-vol-name="$VOL_NAME" --enable-error-stack \
       "$comp_h5" "$dec_h5"; then
    echo "  [FAIL] decompress failed"
    return 1
  fi

  echo "  [3/3] Comparing..."
  local rc=0
  if [[ "$mode" == "lossless" ]]; then
    h5diff "$NATIVE_H5" "$dec_h5" || rc=$?
  else
    h5diff -d "$mode" "$NATIVE_H5" "$dec_h5" || rc=$?
  fi

  local csz=$(stat -c%s "$comp_h5")
  local ratio=$(awk "BEGIN{printf \"%.2f\", $(stat -c%s \"$NATIVE_H5\")/$csz}")
  echo "  Size: native=$(stat -c%s \"$NATIVE_H5\")  compressed=$csz  ratio=${ratio}x"

  if [[ $rc -eq 0 ]]; then
    echo "  [PASS]"
  else
    echo "  [FAIL] h5diff rc=$rc"
  fi
}

# Run tests
roundtrip noop     lossless
roundtrip bzip2    lossless
roundtrip cuszp    "1e-4"

echo "=== DONE ==="