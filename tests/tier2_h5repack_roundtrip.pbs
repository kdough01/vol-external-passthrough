#!/bin/bash
#PBS -N vol_h5repack_roundtrip
#PBS -l select=1:ncpus=4:ngpus=1:mpiprocs=1
#PBS -l walltime=00:25:00
#PBS -j oe
#PBS -A SDR
#PBS -q gpu

# ====================== PATHS ======================
SPACK_ROOT="/home/kdougherty/spack"
LP_VIEW="/home/kdougherty/libpressio_cuda/.spack-env/view"
PROJECT_ROOT="/home/kdougherty/hdf5_projs/vol-external-passthrough"
VOL_BUILD_DIR="$PROJECT_ROOT/build"
CACHE_DIR="/lcrc/project/SDR/kdougherty/ci/h5repack_roundtrip"
NATIVE_H5="$CACHE_DIR/native_density.h5"
WORK="$CACHE_DIR/job_${PBS_JOBID:-local}"

MIRANDA_DIR="/lcrc/project/ECP-EZ/public/compression/Miranda/SDRBENCH-Miranda-256x384x384"
FIELD_FILE="density.f64"
DSET="/field"
NX=256; NY=384; NZ=384
ABS_BOUND="1e-4"

VOL_NAME="pass_through_ext"
VOL_INFO="under_vol=0;under_info={}"

mkdir -p "$WORK" "$CACHE_DIR"
ulimit -c unlimited

echo "=== Environment Setup ==="
module load gcc/11.4.0
module load hpcx/2.26-gcc
module load cuda/12.6.0

source "$SPACK_ROOT/share/spack/setup-env.sh"

GCC_LIB=$(gcc --print-file-name=libstdc++.so | xargs dirname 2>/dev/null)
[ "$GCC_LIB" = "." ] && GCC_LIB=/usr/lib/gcc/x86_64-linux-gnu/11
echo "GCC_LIB: $GCC_LIB"

# ============================================================================
# BUILD PHASE  (isolated env; lifted from the known-good build job)
# ============================================================================
echo "=== Building VOL ==="
cd "$PROJECT_ROOT"

SYSTEM_MPICC=$(which mpicc)
SYSTEM_MPICXX=$(which mpicxx)
echo "mpicc:  $SYSTEM_MPICC"
echo "mpicxx: $SYSTEM_MPICXX"
echo "nvcc:   $(which nvcc)"
"$SYSTEM_MPICC" --version >/dev/null || { echo "FATAL: mpicc broken"; exit 1; }

# Find LibPressio cmake config -- check both lib and lib64
LP_CMAKE_DIR=""
for candidate in \
    "${LP_VIEW}/lib64/cmake/LibPressio" \
    "${LP_VIEW}/lib/cmake/LibPressio" \
    "${LP_VIEW}/lib64/cmake/libpressio" \
    "${LP_VIEW}/lib/cmake/libpressio"
do
    if [ -f "${candidate}/LibPressioConfig.cmake" ] || \
       [ -f "${candidate}/libpressio-config.cmake" ]; then
        LP_CMAKE_DIR="$candidate"; break
    fi
done
if [ -z "$LP_CMAKE_DIR" ]; then
    echo "FATAL: Cannot find LibPressioConfig.cmake under $LP_VIEW"
    find "$LP_VIEW" -name "*ressio*onfig.cmake" 2>/dev/null
    exit 1
fi
echo "LibPressio cmake dir: $LP_CMAKE_DIR"

# strip the spack view from PATH so cmake picks system GCC, not the view toolchain
CLEAN_PATH=$(echo "$PATH" | tr ':' '\n' | grep -v spack-env | tr '\n' ':')

rm -rf build
env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" \
cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DCMAKE_C_COMPILER="$SYSTEM_MPICC" \
    -DCMAKE_CXX_COMPILER="$SYSTEM_MPICXX" \
    -DUSE_CUDA=ON \
    -DCMAKE_PREFIX_PATH="$LP_VIEW" \
    -DLibPressio_DIR="$LP_CMAKE_DIR" \
    -Wno-dev || { echo "FATAL: cmake configure failed"; exit 1; }

env PATH="$CLEAN_PATH" LD_LIBRARY_PATH="$GCC_LIB" \
cmake --build build -j4 || { echo "FATAL: cmake build failed"; exit 1; }

echo "=== Build result ==="
ls -l "$VOL_BUILD_DIR/libhdf5_vol_passthrough.so" \
  || { echo "FATAL: build did not produce libhdf5_vol_passthrough.so"; exit 99; }

# ============================================================================
# RUNTIME PHASE
# ----------------------------------------------------------------------------
# Load the VOL the way HDF5 intends: via HDF5_PLUGIN_PATH (dlopen, RTLD_LOCAL,
# after libhdf5 init). Do NOT LD_PRELOAD the VOL -- preloading maps it a second
# time before HDF5 initializes and pulls its deps ahead of libhdf5, corrupting
# HDF5's free lists and crashing in H5FL_garbage_coll at H5close.
#
# HDF5_VOL_CONNECTOR stays UNSET: this is an asymmetric round-trip where the
# connector is selected per-leg via --dst-vol-name / --src-vol-name. Setting it
# globally would route BOTH legs through the passthrough VOL.
# ============================================================================
export LD_LIBRARY_PATH=${GCC_LIB}:${LP_VIEW}/lib64:${LP_VIEW}/lib
export HDF5_PLUGIN_PATH="$VOL_BUILD_DIR"
unset HDF5_VOL_CONNECTOR
unset LD_PRELOAD          # ensure nothing preloads the VOL

H5REPACK="${LP_VIEW}/bin/h5repack"
H5DIFF="${LP_VIEW}/bin/h5diff"
H5CC="${LP_VIEW}/bin/h5cc"

echo "h5repack: $H5REPACK"; "$H5REPACK" --version
for t in "$H5REPACK" "$H5DIFF" "$H5CC"; do
  [ -x "$t" ] || { echo "FATAL: $t not found/executable"; exit 99; }
done

echo "=== h5repack dependencies ==="
ldd "$H5REPACK"

cd "$WORK"
set -uo pipefail

# ---------------------------------------------------------------------------
# Step 0: ingest raw Miranda binary -> plain native HDF5 (cached)
# ---------------------------------------------------------------------------
if [[ ! -f "$NATIVE_H5" ]]; then
  [[ -f "$MIRANDA_DIR/$FIELD_FILE" ]] \
    || { echo "FATAL: raw data not found at $MIRANDA_DIR/$FIELD_FILE -- check MIRANDA_DIR/FIELD_FILE"; exit 98; }
  echo "== ingesting $FIELD_FILE -> $NATIVE_H5 =="
  cat > ingest.c <<'EOF'
#include "hdf5.h"
#include <stdio.h>
#include <stdlib.h>
int main(int argc, char **argv) {
    if (argc != 7) { fprintf(stderr, "usage: ingest raw out dset nx ny nz\n"); return 2; }
    const char *raw = argv[1], *out = argv[2], *dset = argv[3];
    hsize_t nx = strtoull(argv[4], 0, 10);
    hsize_t ny = strtoull(argv[5], 0, 10);
    hsize_t nz = strtoull(argv[6], 0, 10);
    hsize_t n = nx * ny * nz;
    double *buf = (double *) malloc(n * sizeof(double));
    if (!buf) { fprintf(stderr, "malloc failed\n"); return 3; }
    FILE *f = fopen(raw, "rb");
    if (!f) { perror("fopen"); return 3; }
    if (fread(buf, sizeof(double), n, f) != n) { fprintf(stderr, "short read\n"); return 3; }
    fclose(f);
    hid_t fid = H5Fcreate(out, H5F_ACC_TRUNC, H5P_DEFAULT, H5P_DEFAULT);
    hsize_t dims[3] = {nx, ny, nz};
    hid_t sid = H5Screate_simple(3, dims, NULL);
    hid_t dcpl = H5Pcreate(H5P_DATASET_CREATE);
    hsize_t chunk[3] = {nx, ny, nz};   /* single full-dataset chunk; tune if desired */
    H5Pset_chunk(dcpl, 3, chunk);
    hid_t did = H5Dcreate2(fid, dset, H5T_IEEE_F64LE, sid, H5P_DEFAULT, dcpl, H5P_DEFAULT);
    H5Dwrite(did, H5T_NATIVE_DOUBLE, H5S_ALL, H5S_ALL, H5P_DEFAULT, buf);
    H5Dclose(did); H5Pclose(dcpl); H5Sclose(sid); H5Fclose(fid); free(buf);
    return 0;
}
EOF
  "$H5CC" -O2 ingest.c -o ingest
  ./ingest "$MIRANDA_DIR/$FIELD_FILE" "$NATIVE_H5" "$DSET" "$NX" "$NY" "$NZ"
fi
echo "native source size: $(stat -c%s "$NATIVE_H5") bytes"

# ---------------------------------------------------------------------------
# round-trip helper:  $1 = compressor id   $2 = "lossless" | abs-bound
#
# Only the per-compressor env vars vary here. The library/plugin environment
# (LD_LIBRARY_PATH, HDF5_PLUGIN_PATH, HDF5_VOL_CONNECTOR) is set ONCE in the
# RUNTIME PHASE above and must NOT be overridden per-leg -- in particular do
# not LD_PRELOAD the VOL or re-prepend LD_LIBRARY_PATH.
# ---------------------------------------------------------------------------
FAILS=0
declare -a SUMMARY=()

roundtrip () {
  local comp="$1" mode="$2"
  local comp_h5="comp_${comp}.h5" dec_h5="dec_${comp}.h5"
  echo "============================================================"
  echo "== compressor: $comp   (mode: $mode) =="

  export HDF5_VOL_PRESSIO_COMPRESSOR="$comp"
  if [[ "$mode" != "lossless" ]]; then
    export HDF5_VOL_PRESSIO_LEVEL="$mode"
  else
    unset HDF5_VOL_PRESSIO_LEVEL || true
  fi

  # (1) compress: native source (default VOL), passthrough destination
  echo "  [1/3] compress (--dst-vol-name=$VOL_NAME)"
  if ! "$H5REPACK" --dst-vol-name="$VOL_NAME" --dst-vol-info="$VOL_INFO" \
        --enable-error-stack "$NATIVE_H5" "$comp_h5"; then
    echo "  [FAIL] compress leg failed for $comp"
    SUMMARY+=("$comp: FAIL (compress)"); FAILS=$((FAILS+1)); return
  fi

  # (2) decompress: passthrough source, native destination (default VOL)
  echo "  [2/3] decompress (--src-vol-name=$VOL_NAME)"
  if ! "$H5REPACK" --src-vol-name="$VOL_NAME" --src-vol-info="$VOL_INFO" \
        --enable-error-stack "$comp_h5" "$dec_h5"; then
    echo "  [FAIL] decompress leg failed for $comp"
    SUMMARY+=("$comp: FAIL (decompress)"); FAILS=$((FAILS+1)); return
  fi

  # (3) compare recovered data vs original native
  echo "  [3/3] compare"
  local rc=0
  if [[ "$mode" == "lossless" ]]; then
    env -u HDF5_PLUGIN_PATH -u HDF5_VOL_CONNECTOR \
        "$H5DIFF" "$NATIVE_H5" "$dec_h5" "$DSET" "$DSET" || rc=$?
  else
    env -u HDF5_PLUGIN_PATH -u HDF5_VOL_CONNECTOR \
        "$H5DIFF" -d "$mode" "$NATIVE_H5" "$dec_h5" "$DSET" "$DSET" || rc=$?
  fi

  local nsz csz ratio
  nsz=$(stat -c%s "$NATIVE_H5"); csz=$(stat -c%s "$comp_h5")
  ratio=$(awk "BEGIN{printf \"%.2f\", $nsz/$csz}")
  echo "  size: native=$nsz  compressed=$csz  ratio=${ratio}x"

  if [[ $rc -eq 0 ]]; then
    echo "  [PASS] $comp round-trip within tolerance"
    SUMMARY+=("$comp: PASS  (ratio ${ratio}x)")
  else
    echo "  [FAIL] $comp h5diff rc=$rc (differences exceed tolerance)"
    SUMMARY+=("$comp: FAIL (diff rc=$rc)"); FAILS=$((FAILS+1))
  fi
}

roundtrip noop     lossless
roundtrip bzip2    lossless
roundtrip cuszp    "$ABS_BOUND"

echo "============================================================"
echo "RESULTS:"
for line in "${SUMMARY[@]}"; do echo "  $line"; done
echo "FAILURES: $FAILS"
exit $FAILS
